texto_para_hablar.txt

# Configuración de entrenamiento (si conservas algo del experimento de wake word)
my_model.yaml

# Variables de entorno / secretos, por si algún día agregas API keys
.env

# Archivos de sistema
.DS_Store
Thumbs.db

# VS Code
.vscode/
